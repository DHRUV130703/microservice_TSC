# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo
.vercel/

# Environment / secrets  -- NEVER commit these
.env
.env.*
!.env.example

# Google Cloud service-account credentials
credentials/
*.json.key
*service-account*.json
*-key.json
Key.json
application_default_credentials.json

# Generated schema-discovery reports (contain table/column names)
reports/
scratch/

# The schema mapping is tracked deliberately. It holds no credentials — only
# table, column and status names — and committing it makes deployments
# reproducible and removes the need to paste a 4.5 KB env var into a dashboard.
# Do NOT commit it if this repository ever becomes public.

# Logs
*.log
logs/

# OS / editor
.DS_Store
.idea/
.vscode/
.vercel
