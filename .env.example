# ---------------------------------------------------------------------------
# pincode-metrics-service
# Copy to .env and fill in. NEVER commit .env or the service-account JSON.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Google Cloud / BigQuery ------------------------------------------------
# Project that owns the BigQuery jobs (billing project).
GOOGLE_CLOUD_PROJECT=

# Path to the service-account JSON key. Leave empty to use Application Default
# Credentials (gcloud auth application-default login / Workload Identity).
# The file itself is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/Key.json

# Job location. Must match the datasets' location, e.g. US, EU, asia-south1.
BIGQUERY_LOCATION=asia-south1

# Hard cost ceiling per query, in bytes. Queries that would exceed it fail
# instead of running. 20 GB by default.
BIGQUERY_MAXIMUM_BYTES_BILLED=20000000000
BIGQUERY_TIMEOUT_MS=60000

# --- Schema mapping ---------------------------------------------------------
# Describes the real BigQuery layout. Produced from `npm run discover:schema`.
SCHEMA_MAPPING_PATH=config/schema.mapping.json

# --- Metric window ---------------------------------------------------------
# calendar_months: 1st of the month 5 months back .. today  (2026-08-31 -> 2026-03-01..2026-08-31)
# rolling:         today minus 6 months .. today            (2026-08-31 -> 2026-02-28..2026-08-31)
METRICS_PERIOD_MODE=rolling
METRICS_PERIOD_MONTHS=6
METRICS_TIMEZONE=Asia/Kolkata

# --- API -------------------------------------------------------------------
# Pincode validation pattern. Default: 3-12 alphanumerics, spaces and hyphens.
# For strictly Indian 6-digit pincodes use: ^[1-9][0-9]{5}$
PINCODE_PATTERN=^[A-Za-z0-9][A-Za-z0-9 -]{2,11}$

# How often the reporting window moves. THIS is what governs how often BigQuery
# is queried, because the window's end date is part of the cache key:
#   day   -> at most one BigQuery job per pincode per day
#   week  -> one per week  (window ends on the most recent Sunday)
#   month -> one per month (window ends on the last day of the previous month)
METRICS_PERIOD_ANCHOR=week

# In-process response cache TTL in seconds. 0 disables it.
# Keep this >= the anchor interval so entries survive until the window moves.
# 604800 = 7 days.
METRICS_CACHE_TTL_SECONDS=604800
METRICS_CACHE_MAX_ENTRIES=5000

# Comma-free single origin for CORS, or * for any.
CORS_ALLOW_ORIGIN=*
