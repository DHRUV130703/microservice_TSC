{
  "name": "pincode-metrics-service",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js microservice exposing pincode-level Average Order Value and Conversion Rate from Google BigQuery.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "discover:schema": "tsx src/cli/discover-schema.ts",
    "validate:metrics": "tsx src/cli/validate-metrics.ts",
    "print:sql": "tsx scripts/print-generated-sql.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^7.9.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
