{
  "meta": {
    "discoveredAt": "2026-08-31",
    "project": "devx-tsc",
    "notes": "ALTERNATIVE lead source: view_reports.lead_base, in a stable dataset rather than `temp`. Same conversion definition; the denominator is slightly larger (3,030 vs 2,997 leads for 560076 in the same window) because the two tables differ in pincode coverage. Orders are unchanged."
  },
  "orders": {
    "source": {
      "kind": "table",
      "table": "devx-tsc.view_reports.oms_sales_union"
    },
    "columns": {
      "orderId": "order_id",
      "pincode": "shipping_pincode",
      "orderDate": "date",
      "orderValue": "sales",
      "joinKey": "shipping_phone"
    },
    "orderDateType": "DATE",
    "pincodeMatch": {
      "columnType": "STRING",
      "trim": true,
      "caseInsensitive": false,
      "stripCharacters": ""
    },
    "includeStatuses": [],
    "excludeStatuses": [],
    "statusCaseInsensitive": true,
    "columnFilters": [],
    "booleanFlags": {
      "excludeWhenTrue": [],
      "requireTrue": []
    },
    "requirePositiveValue": false,
    "aovMethod": "total_over_orders"
  },
  "leads": {
    "source": {
      "kind": "table",
      "table": "devx-tsc.view_reports.lead_base"
    },
    "columns": {
      "leadId": "phone",
      "pincode": "recent_pincode",
      "createdAt": "lead_created_on",
      "joinKey": "phone"
    },
    "createdAtType": "DATE",
    "pincodeMatch": {
      "columnType": "STRING",
      "trim": true,
      "caseInsensitive": false,
      "stripCharacters": ""
    },
    "excludeStatuses": [],
    "columnFilters": [],
    "booleanFlags": {
      "excludeWhenTrue": [],
      "requireTrue": []
    },
    "conversion": {
      "strategy": "join_orders",
      "orderWithinPeriod": true,
      "normalizeJoinKey": true,
      "joinKeyStripCharacters": "+-() ",
      "joinKeyLastCharacters": 10
    }
  }
}
